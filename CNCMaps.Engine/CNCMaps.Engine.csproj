<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>CNCMaps.Engine</RootNamespace>
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-windows'">
    <!-- the interactive tile debugging window is WinForms-based -->
    <Compile Remove="Rendering\DebugDrawingSurfaceWindow.cs" />
    <Compile Remove="Rendering\DebugDrawingSurfaceWindow.Designer.cs" />
    <Compile Remove="Rendering\ZoomableCanvas.cs" />
    <Compile Remove="Rendering\Gdi32.cs" Condition="Exists('Rendering\Gdi32.cs')" />
    <EmbeddedResource Remove="Rendering\DebugDrawingSurfaceWindow.resx" />
  </ItemGroup>
  <ItemGroup>
    <!-- start position marker images, loaded through MarkerResources -->
    <EmbeddedResource Include="Resources\*.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NLog" Version="5.5.0" />
    <PackageReference Include="OpenTK.Mathematics" Version="4.9.4" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.6" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CNCMaps.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CNCMaps.FileFormats\CNCMaps.FileFormats.csproj" />
    <ProjectReference Include="..\CNCMaps.Shared\CNCMaps.Shared.csproj" />
  </ItemGroup>
</Project>
